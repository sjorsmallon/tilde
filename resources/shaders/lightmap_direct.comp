#version 460
#extension GL_EXT_ray_query : require

// lightmap_gpu_plan.md step 6: the direct kernel. shade_sample_direct of
// lightmap_solve.cpp in GLSL, one sample record per thread: arrival_at through
// the shared text, light_visibility's golden-angle disc ported hash for hash so
// a punctual light's answer is the SAME ray the CPU casts and an area light's
// penumbra the same spiral, the coverage and the ranking weight per light, the
// chart's light mask gating the irradiance sum, and Visibility mode's
// max-of-visibility arm. The GPU sees points and lights; never a chart.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;

// gpu_bake_settings_t follows the two counts; lightmap_gpu_vulkan.cpp asserts
// the layout.
layout(push_constant) uniform Push
{
  uint sample_count;
  uint light_count;
  uint mode;
  int rays_per_sample;
  int bounces_before_roulette;
  int max_bounces;
  float ray_bias;
  float shadow_ray_bias;
  int soft_shadow_samples;
  float directional_shadow_distance;
} push;

#include "lightmap_bake.glsl"

layout(std430, set = 0, binding = 1) readonly buffer Samples { gpu_sample_t samples[]; };
// Three regions, in this order: vec4 per record (irradiance rgb, and in w the
// number of shadow rays this record cast, for the report line), then the
// coverage per (record, light) and the weight per (record, light), both
// sample-major -- gpu_direct_results_t's three lists laid end to end.
layout(std430, set = 0, binding = 2) writeonly buffer Results { float results[]; };
// One 64-bit mask per chart of the batch, low word first, indexed by the
// record's chart_index: which lights may sum into the irradiance.
layout(std430, set = 0, binding = 3) readonly buffer Chart_Light_Masks { uvec2 chart_light_masks[]; };
layout(std430, set = 0, binding = 4) readonly buffer Lights { Light lights[]; };

// lightmap_solve_mode_t::Visibility.
const uint MODE_VISIBILITY = 1u;

void main()
{
  const uint i = gl_GlobalInvocationID.x;
  if (i >= push.sample_count) return;

  const gpu_sample_t sample_record = samples[i];
  const uvec2 mask = chart_light_masks[sample_record.chart_index];
  const bool binary = push.mode == MODE_VISIBILITY;

  const uint coverage_base = push.sample_count * 4u + i * push.light_count;
  const uint weight_base = coverage_base + push.sample_count * push.light_count;

  vec3 irradiance = vec3(0.0);
  uint rays = 0u;

  for (uint slot = 0u; slot < push.light_count; ++slot)
  {
    // The buffer is reused across dispatches: a light that does not arrive
    // writes its zero rather than leaving the last dispatch's answer.
    float coverage = 0.0;
    float weight = 0.0;

    const Light light = lights[slot];
    const bake_arrival_t arrival = arrival_at(light, sample_record.position, sample_record.normal);
    if (arrival.arrives)
    {
      rays += uint(shadow_ray_count(arrival));
      const float visibility = light_visibility(sample_record.position, sample_record.normal,
                                                arrival, hash_mix(sample_record.seed, slot));
      if (visibility > 0.0)
      {
        coverage = visibility;
        weight = visibility * arrival.attenuation * luminance_of(light.radiance.rgb);

        if (arrival.reaches)
        {
          if (binary)
          {
            const float strongest = max(irradiance.x, visibility);
            irradiance = vec3(strongest);
          }
          else if (mask_admits(mask, slot))
          {
            irradiance += light.radiance.rgb *
                          (arrival.attenuation * arrival.normal_dot_light * visibility);
          }
        }
      }
    }

    results[coverage_base + slot] = coverage;
    results[weight_base + slot] = weight;
  }

  const uint at = i * 4u;
  results[at + 0u] = irradiance.x;
  results[at + 1u] = irradiance.y;
  results[at + 2u] = irradiance.z;
  results[at + 3u] = float(rays);
}
