// cvars.def -- console variable and command definition DSL.
//
// Parsed by src/tools/def_gen.cpp, which emits into generated/ -- every name
// ends in _generated, and open_generated_file refuses one that does not:
//
//   cvars_generated.{hpp,cpp}              cvar_state_t, the ids, the info tables,
//                                          the text conversion, handler declarations
//   server_command_bindings_generated.cpp  fills the @Server slots -- into game_server
//   client_command_bindings_generated.cpp  the @Client slots -- into game_client
//
// ---------------------------------------------------------------------------
// WHAT THE THREE FLAGS MEAN
// ---------------------------------------------------------------------------
//   (none)      shared-local: both sides have the value, each process owns its
//               own. Never synced. This is the default and most cvars want it.
//
//   @Client     client-owned; meaningless on a dedicated server. Never synced.
//
//   @Server     server-owned. A networked client may INVOKE or INSPECT it
//               through the console (the line is forwarded), but the value is
//               never pushed down.
//
//   @Mirrored   server-owned, server leads; clients hold a read-only mirror
//               kept fresh over the wire. Earn it the same way a field earns
//               @Networked: the client must READ the value AND be required to
//               agree with the server about it. Today that means exactly one
//               thing -- movement prediction.
// ---------------------------------------------------------------------------
// TYPES
// ---------------------------------------------------------------------------
// f32 / i32 / u32 / bool / string<N> / an enum declared in this file. string<N>
// was parked with zero users in v1 -- `map` was the only string cvar and became
// a command below -- but the generator implemented it anyway, and `name` in the
// Client block is its first user (2026-08-25). It emits a
// network::pascal_string_t<N> member and goes through the same
// try_cvar_to_text / try_cvar_from_text as every other type.
//
// An ENUM cvar is one uint8_t and converts by VALUE NAME in both directions, so
// `sv_gamemode 7` is a rejection rather than a mode nobody declared. Reach for
// it when the value is a CHOICE: a number that could be anything is an i32 or
// an f32, and a name picked from a closed set is an enum. The alternative --
// a string<N> resolved by hand at the read site -- is a second parser for
// something the generator already knows, which is exactly what sv_gamemode was
// until 2026-08-26.

// movement_def.md: a LOCOMOTION MODEL is a complete, named movement style, and
// the cvars it reads are its own group with its own prefix. A number belongs to
// exactly one reader -- shared, one model, or one item -- and the prefix is what
// says which where a map file or a console line is the only context.
// movement_settings_from fills only the group pm_model names, so a pm_quake_*
// value cannot reach the instant model, and apply_map_cvars warns when a map
// sets one its own pm_model does not read.

Bunnyhop_Mode :: enum { none, hl2, cs }
Locomotion_Model :: enum { quake, instant, instant_momentum, instant_redirect }

// Read by every model and by the kernel.
Player_Movement :: cvars {
    pm_model:               Locomotion_Model = .quake  @Mirrored  "Movement style: quake (accelerate against friction), instant (horizontal velocity IS the input), instant_momentum (the same input rule beside a momentum outside speed lands in) or instant_redirect (the same, but carried speed can only be AIMED, never added to or cancelled)"
    pm_maxspeed:            f32 = 320.0       @Mirrored  "Run speed: the most your own acceleration pushes you to"
    pm_overbounce:          f32 = 1.001       @Mirrored  "Plane clip overbounce factor"
    pm_jumpspeed:           f32 = 270.0       @Mirrored  "Jump velocity"
    g_gravity:              f32 = 800.0       @Mirrored  "Gravity"
    pm_speed_threshold:     f32 = 1.0         @Mirrored  "Speed below which a decay snaps to zero"
    pm_step_height:         f32 = 18.0        @Mirrored  "Maximum step height the player can glide up"
    pm_minimum_land_impact_speed: f32 = 150.0 @Mirrored  "Threshold for speed to cause audio to play when landing"

    pm_air_jump_count:      i32 = 0          @Mirrored  "Air jumps allowed before touching ground again (0 = none)"
    pm_air_jump_speed:      f32 = 270.0      @Mirrored  "Upward velocity an air jump sets"
}

// Read only when pm_model is quake. pm_quake_bunnyhop stays an enum INSIDE the
// model: it selects a behaviour over fields that are all live, which is the
// lights rule's second kind.
Quake_Movement :: cvars {
    pm_quake_friction:            f32 = 6.0    @Mirrored  "Ground friction"
    pm_quake_stop_speed:          f32 = 100.0  @Mirrored  "Speed below which friction becomes a constant drop instead of a decay"
    pm_quake_ground_acceleration: f32 = 10.0   @Mirrored  "Ground acceleration"
    pm_quake_air_acceleration:    f32 = 5.0    @Mirrored  "Air acceleration"

    pm_quake_bunnyhop:            Bunnyhop_Mode = .none  @Mirrored  "Where hop speed comes from: none (hops only keep speed), hl2 (ground jumps add pm_quake_jump_boost), cs (air strafing up to pm_quake_air_speed_cap)"
    pm_quake_jump_boost:          f32 = 32.0   @Mirrored  "hl2: speed a ground jump adds along the held direction"
    pm_quake_jump_boost_max_speed: f32 = 480.0 @Mirrored  "hl2: horizontal speed a jump boost stops at"
    pm_quake_air_speed_cap:       f32 = 30.0   @Mirrored  "cs: speed an air push stops adding at, along its own direction"
}

// Read only when pm_model is instant.
Instant_Movement :: cvars {
    pm_instant_speed_return_seconds: f32 = 0.5 @Mirrored  "How long speed from a pad, a dash, Set_Velocity, Add_Velocity or knockback outlasts your input"
}

// Read only when pm_model is instant_momentum. There is no speed_return_seconds
// here on purpose: the memory is the momentum itself, so it bleeds rather than
// falling off a cliff when a timer runs out.
Instant_Momentum_Movement :: cvars {
    pm_instant_momentum_ground_drag: f32 = 10.0 @Mirrored  "How fast momentum from a pad, a dash or knockback bleeds while walking (exponential, per second)"
    pm_instant_momentum_air_drag:    f32 = 0.0  @Mirrored  "The same in the air. Zero flies the arc the editor draws"
}

// Read only when pm_model is instant_redirect. Carried speed is the velocity
// itself here, and the input may only AIM it: nothing adds to it and nothing
// cancels it, so a launch is steered rather than summed with.
Instant_Redirect_Movement :: cvars {
    pm_instant_redirect_turn_degrees_per_second: f32 = 360.0 @Mirrored  "How fast the input can swing carried speed around. A half turn takes 180/this seconds"
    pm_instant_redirect_ground_drag:             f32 = 10.0  @Mirrored  "How fast carried speed bleeds back to pm_maxspeed while walking (exponential, per second)"
    pm_instant_redirect_air_drag:                f32 = 0.0   @Mirrored  "The same in the air. Zero keeps a launch until you land"
}

// The hook's reel is an OVERRIDE, and an override's numbers are written into
// Movement at ATTACH by whoever attaches it (movement_def.md). So these are
// read once, on the server, by the system that hooks somebody -- never inside
// player_move -- which is what takes them off the wire and out of the pm_
// family. The client predicts the reel from the replicated state instead.
Hook :: cvars {
    sv_hook_pull_speed:       f32 = 900.0  @Server  "Speed every reel pulls at; how long one lasts is the weapon row's contact"
    sv_hook_arrive_radius:    f32 = 48.0   @Server  "Distance from the anchor the reel lets go at"
}

Gameplay :: cvars {
}

// ---------------------------------------------------------------------------
// Match rules -- game_modes_def.md
// ---------------------------------------------------------------------------

// The mode itself is not a cvar: it is Game_Rules_Entity's `mode` field.
Match :: cvars {
    // A phase whose duration is 0 has no deadline and ends only on a win
    // condition. Game_Over has no cvar at all: it is terminal.
    // 0 means warmup has NO deadline and ends only when start_match says enough
    // players have connected -- which is what a warmup is for. A non-zero value
    // auto-starts the match after that many seconds whether anyone is there or
    // not, and at the old default of 5 the match reliably began with an empty
    // server before the first player finished loading.
    mp_warmup_seconds:      f32 = 0.0     @Server  "Warmup length before the match auto-starts (0 = wait for players)"
    mp_countdown_seconds:   f32 = 5.0     @Server  "Countdown from an all-ready vote to round 1; un-readying cancels it (0 = start at once)"
    mp_freeze_seconds:      f32 = 3.0     @Server  "Per-round freeze length (unused by modes with no freeze phase)"
    mp_round_seconds:       f32 = 180.0   @Server  "Round time limit"
    mp_round_end_seconds:   f32 = 5.0     @Server  "Post-round settle length before the next round begins"
    mp_next_map_seconds:    f32 = 5.0     @Server  "How long a reached objective is held before next_map loads; a restart cancels it (0 = hold until asked)"

    // Game_Over is terminal for the MATCH, not for the server: when it expires
    // the map reloads and the whole thing starts again at Warmup. 0 holds the
    // final scoreboard forever, which is what a server being handed to a map
    // vote or a rotation wants -- neither of which exists yet.
    mp_game_over_seconds:   f32 = 10.0    @Server  "How long the final scoreboard is held before the map restarts (0 = hold it forever)"

    // The fewest CLIENTS WITH A BODY that can leave warmup, and then only once
    // every one of them has voted `ready`. Joined players, not connections:
    // four people who are all spectating are not a match. Bots neither count
    // nor vote -- they have no client slot -- so one player and a
    // console-spawned bot start the moment that player is ready.
    //
    // 0 never starts from the vote, which leaves Start_Match to the map's
    // wiring, the console or mp_warmup_seconds.
    //
    // Raise it in a map's attached_cvars block for a match that should wait for
    // a full lobby.
    mp_players_to_start:    i32 = 1       @Server  "Joined players needed before an all-ready vote leaves warmup (0 = never start from the vote)"

    // Win_Condition::Frag_Limit. 0 disables it, leaving mp_round_seconds as the
    // only thing that ends a deathmatch.
    mp_frag_limit:          i32 = 20      @Server  "Kills one player needs to end a Frag_Limit match (0 = no limit)"
}

// ---------------------------------------------------------------------------
// Aim pose geometry -- animation_def.md §4/§5
// ---------------------------------------------------------------------------
//
// @Mirrored, and they used to be cl_aim_* @Client. What moved them: the server
// now poses the hit volumes through the same aim blend the client draws, so
// these three are inputs to a HIT DECISION. Two sides disagreeing about
// sv_aim_max_yaw is two sides disagreeing about where a twisted torso is.
// Server-owned with a read-only client copy is the same shape as pm_*, for the
// same reason.
//
// The two extents describe the AUTHORED pose set, so they are not free tuning
// -- they should match how far the `upward`/`downward`/`left`/`right` poses
// actually reach. Aiming further clamps to the extreme rather than
// extrapolating past a pose nobody authored.

Aim :: cvars {
    sv_aim_max_pitch:       f32 = 45.0        @Mirrored  "Pitch extent of the authored aim pose set, in degrees"
    sv_aim_max_yaw:         f32 = 45.0        @Mirrored  "Yaw extent of the authored aim pose set, in degrees"
    // The feet lag the view and catch up at this rate, and the difference is
    // what drives the left/right poses. At 0 the feet only ever move when the
    // view passes sv_aim_max_yaw, so the torso stays twisted.
    sv_aim_body_turn_rate:  f32 = 540.0       @Mirrored  "How fast a player model's feet chase their view yaw, degrees/second"
}

// The Flashlight's cone (shared/reveal_light.hpp). @Mirrored: what a client draws as revealed and what the server makes solid are the same two numbers.
Reveal_Light :: cvars {
    sv_reveal_light_range:      f32 = 1024.0  @Mirrored  "How far a Flashlight reveals and lights, in world units"
    sv_reveal_light_half_angle: f32 = 25.0    @Mirrored  "Half the opening angle of a Flashlight's cone, in degrees, at most 89"
    sv_reveal_light_overhead_height: f32 = 256.0 @Mirrored  "How far above its holder's eye an overhead Flashlight's cone starts, in world units"
}

// ---------------------------------------------------------------------------
// Lag compensation -- lag_compensation_def.md
// ---------------------------------------------------------------------------
//
// @Server and NOT @Mirrored: the client makes no decision from any of these. It
// reports the blend it drew through unconditionally; whether the server rewinds
// through it, how far back it may reach and whether that gets logged are all
// the server's business alone.
//
// The policy these encode is shooter-favored -- "I hit what my crosshair was
// on" -- and the bill is that a victim already behind cover on both screens can
// still take damage. sv_max_rewind_ticks is what bounds that bill.

Lag_Compensation :: cvars {
    sv_lag_compensation:       bool = true   @Server  "Rewind targets to what the shooter saw"
    sv_max_rewind_ticks:       i32  = 12     @Server  "Cap on how far back a shot may reach (~200ms at 60Hz)"
    sv_lag_compensation_debug: bool = false  @Server  "Log every rewind: requested bracket, clamped bracket, disparity, hit"
    // The VISUAL half of the above. Sends S2C_ShotDebug to the shooter for every
    // shot they resolve: the ray, the rewind verdict, and the pose of every
    // target the server ranked. Shooter-only and off by default -- it is one
    // message per shot per client, which is fine for two people debugging and
    // not fine for a full server.
    sv_shot_debug:             bool = false  @Server  "Send each shooter the server's view of their own shots (S2C_ShotDebug)"
}

// The placeholder world ping: middle mouse raycasts against the map and stands
// a duck where it landed. One marker per player, so a second ping moves the
// first rather than filling the level with waterfowl.

Ping :: cvars {
    sv_ping_range:            f32 = 8192.0 @Server "How far a ping ray reaches before it gives up"
    sv_ping_lifetime_seconds: f32 = 10.0   @Server "Seconds a ping marker stands before it vanishes (0 = forever)"
}

// ---------------------------------------------------------------------------
// Server -- was server_impl.cpp
// ---------------------------------------------------------------------------

Server :: cvars {
    // NOT @Mirrored: the
    // client learns the tickrate once from CmdAccept at handshake time, which
    // is a handshake fact, not a live-synced value.
    sv_tickrate:            f32 = 60.0      @Server    "Server tick rate in Hz"

    // A connected client sends a move every tick, so silence this long means the
    // peer is gone: a crash, a pulled cable, or a CmdDisconnect that was itself
    // lost. 0 disables it, which is what you want while stepping a client
    // through a debugger.
    sv_timeout:             f32 = 30.0      @Server    "Seconds of silence before a client is dropped (0 = never)"

    // A client accrues one move credit per tick and spends one per executed
    // move, so it can never execute more moves over time than the server
    // ticked. This is how many it may BANK -- the burst that absorbs a network
    // stall without the client losing input it honestly generated. Beyond it,
    // moves are dropped and the client rubber-bands. See server/move_budget.hpp
    // for why a per-tick cap does not bound the exploit at all.
    sv_max_move_backlog:    i32 = 8         @Server    "Move commands a client may bank and execute in one tick after a stall"

    // UDP has no flow control, so a bulk send is bounded here or not at all. A
    // map package is up to 255 datagrams; handed to the socket in one loop it
    // overruns the receiver's kernel queue and most of it is discarded before
    // the client's first recvfrom -- which no receive-side change can recover,
    // and which made a download retry forever without ever converging.
    //
    // At 60Hz, 32 fragments is ~2.3 MB/s: a 12 MB compressed package in about five
    // seconds. What bounds it is the client's receive queue
    // (client_receive_buffer_size_in_bytes), which has to hold what arrives while
    // a frame stalls. This is the same knob Source spells sv_maxrate, in
    // fragments rather than bytes because our fragments are fixed.
    sv_map_transfer_fragments_per_tick: i32 = 32 @Server "Map-package fragments sent per client per tick"
}

Client :: cvars {
    // Sent once in CmdConnect and never again: the server sanitizes it, holds
    // it on the slot, and copies it onto the Player_Entity, which is what
    // actually replicates it. Changing this mid-session therefore does nothing
    // until the next connect -- deliberate, since a rename would otherwise need
    // a C2S message of its own for a prototype that has no rename UI.
    name:                   string<32> = "Player"  @Client  "Name shown to other players"

    // Every move the client has not seen acked rides in every move datagram, so
    // one lost packet is not one lost tick of input. This bounds how far that
    // tail may grow: past it the oldest moves are dropped, because a move older
    // than this is one the server will refuse to rewind to anyway. Eight moves
    // is roughly 500 bytes against the 1200-byte packet cap.
    cl_max_unacked_inputs:   i32 = 8         @Client    "Unacknowledged client inputs resent in every input datagram"

    r_fov:                  f32 = 90.0      @Client    "Field of view in degrees"

    // Zoom is presentation, so all of it is @Client. The server learns only
    // that the client is zoomed, via Button::Zoom in the client's input --
    // right-click toggles that state, and the toggle edge stays client-side.
    // which is what it would need to apply a movement or accuracy penalty. It
    // never needs the angle.
    r_zoom_fov:             f32 = 30.0      @Client    "Field of view in degrees while zoomed"
    r_zoom_easing_time_between_fovs:            f32 = 0.00      @Client    "Seconds to ease between normal and zoomed FOV (0 = instant)"

    // Shadow maps, lighting_def.md gate 9. The pool is FIXED: a frame with more
    // shadow-casting lights than layers ranks them by intensity over distance
    // squared to the camera and draws the rest unshadowed, logged once per light.
    r_shadow_map_size:      i32 = 1024      @Client    "Shadow map resolution per layer"
    r_shadow_layer_count:   i32 = 12        @Client    "Shadow map layers in the pool (at most 16); the sun's cascades take one each, a point light takes six"
    r_shadow_light_offset:  f32 = 1.0       @Client    "Receiver offset toward the light before the compare, in shadow texels"
    r_shadow_bias_slope:    f32 = 2.5       @Client    "Shadow depth bias, slope-scaled factor"
    r_shadow_normal_offset: f32 = 1.5       @Client    "Receiver offset along the normal, in shadow texels"
    r_shadow_pcf_radius:    i32 = 1         @Client    "PCF kernel radius in texels (0 = the hardware 2x2 only)"
    r_shadow_pcss:          bool = true     @Client    "Widen the PCF kernel from the light's source_radius and the blocker distance (PCSS)"
    r_shadow_pcss_max_radius: f32 = 16.0    @Client    "Cap on the PCSS search and filter radius, in shadow texels"
    r_shadow_debug_light:   i32 = 0         @Client    "Entity uid of the light r_debug_channel shadow_visibility shows; 0 picks the shadowed light nearest the camera"

    // The lightmap bake, lightmap_gpu_plan.md step 7b. Honoured only where the
    // device offers ray query; elsewhere the CPU reference solve runs and the
    // Lightmap tool's status line says why.
    r_lightmap_gpu:         bool = true     @Client    "Bake lightmaps through the Vulkan ray query solver when the device offers it; off runs the CPU reference solve"

    // The sun's map is CASCADED (gate 9 step 2): the view frustum is cut into
    // slices by depth and each slice gets a map of its own, fit to the slice's
    // bounding sphere and snapped to a texel so it does not shimmer.
    r_shadow_cascade_count:         i32 = 3       @Client "Cascades the sun's shadow is split into (1 to 4)"
    r_shadow_cascade_lambda:        f32 = 0.7     @Client "Cascade split scheme: 0 uniform in depth, 1 logarithmic"
    r_shadow_cascade_distance:      f32 = 4096.0  @Client "View distance the sun's runtime shadow reaches"
    r_shadow_cascade_blend:         f32 = 0.1     @Client "Blend band at each cascade seam, as a fraction of the split depth"
    r_shadow_cascade_caster_extent: f32 = 8192.0  @Client "How far toward the sun a cascade's box reaches for casters"
    r_shadow_freeze:                bool = false  @Client "Freeze the sun's cascade fit at the current camera and draw its slices and boxes"

    // Degrees of view rotation per mouse count. Was a bare 0.1 literal in
    // play_state.
    m_sensitivity:          f32 = 0.1       @Client    "Mouse look sensitivity"
    // 1.0 keeps the felt sensitivity constant across the zoom: the same hand
    // movement sweeps the same distance across the screen at any FOV. 0 makes
    // zoom not slow the mouse down at all.
    m_zoom_sensitivity_ratio: f32 = 1.0     @Client    "How much zoom scales mouse sensitivity (1 = constant feel, 0 = none)"

    cl_maxfps:              f32 = 1000.0    @Client    "Maximum client framerate (0 = unlimited)"

    // How far behind the newest received snapshot remote entities are drawn.
    // THE SLACK IS THE PRODUCT: this is the entire jitter and loss budget, and
    // it is a straight trade -- every tick of delay is a tick of extra latency
    // on what you see of everyone else, and a tick of extra rewind the server
    // must be willing to do. 2 covers a single dropped snapshot; 3 covers two.
    //
    // Less new latency than it looks: the old arrival-phase scheme already drew
    // between 0 and 1 tick behind, so 2 costs about ONE tick over what it
    // replaced -- and the moments it sat at 0 behind were the frozen ones.
    //
    // TICKS, not milliseconds, which is the opposite of Source's cl_interp. A
    // tick is the snapshot cadence, so "2" means "two snapshots of slack" --
    // the quantity that actually matters -- and it keeps meaning that if
    // sv_tickrate moves. A millisecond value silently becomes a different
    // number of snapshots the moment it does.
    //
    // Below 1 the far end of the bracket is a packet that has not arrived, so
    // the clock is racing arrival again with no budget at all. Above ~4 it
    // starts eating sv_max_rewind_ticks (12), which is a fairness call rather
    // than a tuning knob -- see lag_compensation_def.md.
    cl_interpolation_delay_ticks: f32 = 2.0   @Client    "Server ticks behind the newest snapshot that remote entities are drawn"
    cl_smooth_drawn_tick: bool = true         @Client    "Movers, moving lights and everything else drawn from the predicted tick glide when the server takes one of our inputs a tick late or early; off draws them at the snapshot's own count, which hops a whole tick"

    // A dry interpolation buffer is real packet loss, not a rendering detail:
    // it means loss exceeded cl_interpolation_delay_ticks and a remote player
    // visibly froze. This is what distinguishes "the network is bad" from "the
    // buffer is mis-sized", and without it those two look identical.
    cl_interpolation_debug: bool = false      @Client    "Log interpolation buffer stalls and clock snaps"

    // How long after a frame is handed to the presenter its pixels reach the
    // player's eyes: queued frames, the compositor, scanout, and whatever the
    // panel does. A shot is aimed at what was ON SCREEN, so this is what
    // decides which drawn frame a trigger press is judged against
    // (remote_interpolation.hpp, drawn_history_t).
    //
    // Compensating it is fair because it is a property of the MACHINE -- a
    // fixed offset that corrupted the timestamp of what the player saw. Human
    // reaction time is not, and must never be folded in here however tempting
    // the symmetry looks: it is unmeasurable per shot (a pre-aimed corner is
    // ~0ms, a flick is ~250ms), it is already priced into where the player
    // chose to aim, and at 9-15 ticks it would eat sv_max_rewind_ticks whole
    // and kill people who were behind cover on both screens.
    //
    // 0 is the honest default: it means "assume the pixels landed when
    // render_frame returned", which is what the client did before this existed.
    // Raise it to what you measure. Capped at half the rewind budget on read.
    cl_display_latency_ms: f32 = 0.0          @Client    "Present-to-photons latency a shot is rewound by, in milliseconds"


    cl_draw_player_hull:    bool = false     @Client    "Draw remote players as their collision hull, over the model"

    // Ride another player's eye. Purely a debug view: it reads the same
    // INTERPOLATED position/angles the remote model is drawn from, so a
    // spinning idle bot turns any interpolation stall into visible camera
    // judder. Bots occupy slots from sv_max_client_count (32) up.
    cl_spectate_slot:       i32 = -1         @Client    "Spectate a player slot through its eyes (-1 = off; bots start at 32)"

    // replay_def.md ss6: off shows the server's truth for the same slot, for comparison.
    cl_replay_player_view:  bool = true      @Client    "In a replay, spectate through the recorded aim and draw the others where that player saw them"

    // replay_def.md ss8. The window's close box writes this, the way the entity
    // debug overlay's does.
    cl_replay_panel:        bool = true      @Client    "Show the replay scrub panel while a replay is playing"

    cl_ghost_show:          bool = true      @Client    "Draw the map's fastest-run ghost while a timed run is live"

    // A free camera flown with the editor's controls, and NOTHING moves the
    // body: it stays where it stood, still simulated and still shootable, and
    // the view returns to its own aim when this goes off. A cvar rather than a
    // bare command because it has a current value; `noclip` is the toggle over
    // it.
    cl_noclip:              bool = false     @Client    "Detach the camera from the body and fly it with the editor's controls"

    // The aim pose EXTENTS moved to the @Mirrored `Aim` block above when the
    // server started posing hit volumes with them. What is left here is the
    // scrub rig, which is presentation only.
    //
    // Aim blend rig. The blend is a pure function of (pitch, yaw deviation),
    // and NEITHER input is reachable by watching a live player: a bot's pitch
    // is always 0, and the feet chase its view yaw fast enough that the
    // deviation collapses to 0 every frame. So there is no gameplay situation
    // that sweeps the pose space -- these force the pair directly, for every
    // remote model drawn, and an ImGui panel scrubs them.
    // Skips the directional sun on player models: albedo straight to the
    // screen, via the unlit skinned pipeline. Half a character sitting in 0.15
    // ambient is the wrong light to judge a pose by.
    cl_player_unlit:        bool = false     @Client    "Draw player models unlit -- easier to read a pose than under the sun"

    cl_blob_shadow:            bool = true   @Client    "Draw a soft blob under every player where a straight-down ray hits the ground"
    cl_blob_shadow_radius:     f32 = 20.0    @Client    "Blob shadow radius at the feet, world units"
    cl_blob_shadow_opacity:    f32 = 0.6     @Client    "Blob shadow opacity at the feet"
    cl_blob_shadow_max_distance: f32 = 1024.0 @Client   "How far below the feet the blob still draws; it shrinks and fades toward this"

    cl_aim_debug:           bool = false     @Client    "Force every remote player's aim blend to cl_aim_debug_pitch/_yaw and show the scrub panel"
    cl_aim_debug_pitch:     f32 = 0.0        @Client    "Aim blend pitch forced while cl_aim_debug is on, degrees"
    cl_aim_debug_yaw:       f32 = 0.0        @Client    "Aim blend yaw DEVIATION forced while cl_aim_debug is on, degrees"

    // The deploy gate, on screen. A weapon switch blocks every weapon until the
    // incoming one is up (Inventory::deploy_complete_time), and that is
    // invisible from inside the game -- the shot simply does not happen, which
    // is indistinguishable from a broken fire path at the only moment anyone
    // looks. Off by default: it draws the CLIENT's predicted clock, which is a
    // number, and a number on screen is not what a shipped HUD shows for this.
    cl_show_deploy_timer:   bool = false     @Client    "Draw the seconds left on a weapon switch before anything may fire"

    cl_auto_equip_weapon_on_pickup: bool = true @Client "Switch to a weapon the moment you walk over it"

    // Crosshair. All pixel units, unscaled -- there is no UI scale factor in
    // the client yet, so these are literal framebuffer pixels.
    cl_crosshair:           bool = true      @Client    "Draw the crosshair"
    cl_crosshair_dot:       bool = true      @Client    "Draw the crosshair's center dot"
    cl_crosshair_size:      f32 = 7.0        @Client    "Length of each crosshair line in pixels"
    cl_crosshair_gap:       f32 = 5.0        @Client    "Pixels between the center and where each line starts"
    cl_crosshair_thickness: f32 = 2.0        @Client    "Crosshair line thickness in pixels"
    // Colour as four u32 channels rather than one packed value: the console
    // edits one number at a time, and there is no colour cvar type.
    cl_crosshair_r:         u32 = 0          @Client    "Crosshair red (0-255)"
    cl_crosshair_g:         u32 = 255        @Client    "Crosshair green (0-255)"
    cl_crosshair_b:         u32 = 0          @Client    "Crosshair blue (0-255)"
    cl_crosshair_a:         u32 = 255        @Client    "Crosshair alpha (0-255)"
}

Editor ::cvars {
    editor_speed: f32 = 1600.0              @Client    "default movement speed of the camera in the editor"
}

// ---------------------------------------------------------------------------
// Time -- was game_cvars.cpp
// ---------------------------------------------------------------------------

Time :: cvars {
    // Deliberately UNFLAGGED, and it is the live proof of the bug this whole
    // track fixes. cl_timescale has two readers: main_integrated.cpp:92 scales
    // the SERVER tick accumulator, client_impl.cpp:142 scales the CLIENT frame
    // dt. Those live in the exe and in game_client.dll, which each link
    // game_shared statically -- so today they read two DIFFERENT copies, and
    // setting it from the console only reaches the client's. Slow-mo currently
    // slows rendering while simulation runs at full speed. One launcher-owned
    // cvar_state_t makes both readers see one value, which is the behavior the
    // name always implied. Not @Client despite the cl_ prefix: the prefix is a
    // taxonomy, the flag is an ownership claim, and a server reader disqualifies
    // it from being client-owned.
    cl_timescale:           f32 = 1.0                  "Time scale factor (0.5 = slow-mo, 2.0 = fast)"
}

// ---------------------------------------------------------------------------
// Audio -- was Audio_System.cpp (file-scope statics, so console-visible only in
// whichever module happened to link them)
// ---------------------------------------------------------------------------
//
// Read once per voice at ma_sound spawn time, so a change applies to the next
// sound played, not to sounds already in flight. That is the existing behavior
// and is the reason no on-change callback is needed here.

Audio :: cvars {
    sound_reference_distance:  f32 = 150.0  @Client    "Distance (world units) within which a 3D sound is at full volume"
    sound_max_distance_cutoff: f32 = 4000.0 @Client    "Distance (world units) past which 3D attenuation stops increasing"
    sound_rolloff_factor:      f32 = 1.0    @Client    "3D distance attenuation rolloff factor"
}


Map :: cvars {
    map_respawn_delay_seconds: f32 = 3.0      @Mirrored    "Time between respawns."
    map_kill_limit: i32 = 25                  @Mirrored    "Maximum amount of kills for a round."
    map_round_time_limit_seconds: f32 = 6000  @Mirrored    "Maximum round duration limit."
    next_map: string<128> = ""                @Server      "Next map to load. not immediate, but after this map is done (whatever that means)."
}

Debug_Channel :: enum { off, normals, uv, parallax_uv, shadow_visibility, shadow_cascades, direct_light, baked_light, probe_visibility, shadow_penumbra, reflection, reflection_capture, ink_normals }
Cel_Fill :: enum { none, hatch, dither3d, dither3d_original }
Pattern_Kind :: enum { none, stripes, grid, checks, bricks, chevrons, dots }

Debugging :: cvars {

    // No flag, so shared-local: both a client and a dedicated server pin their
    // own main thread and neither cares what the other did. Read ONCE at
    // startup, before the loop -- changing it later would have to un-pin, and
    // "which cores am I on" is not a thing worth making settable mid-session.
    pin_main_thread:        bool = true                 "Pin the main thread to the CPU's performance cores on a hybrid CPU"

    r_debug_channel:        Debug_Channel = .off @Client "Show a material channel instead of the shaded result (off, normals, uv, parallax_uv, shadow_visibility, shadow_cascades, direct_light, baked_light, probe_visibility, shadow_penumbra, reflection, reflection_capture, ink_normals)"

    // The tonemap pass multiplies the HDR target by this before the curve
    // (lighting_def.md decision J). It is what decision H says
    // LIGHT_REFERENCE_DISTANCE is a placeholder for, so a map lit too hot is
    // retuned here rather than by rescaling every light.
    //
    // 1.4 is HALF A STOP above the identity, and the smallness is the finding:
    // the light unit sits half a stop below where PBR Neutral puts middle grey,
    // which is a calibration offset rather than the authoring inconsistency that
    // would have earned a rescale of every light in every map.
    r_exposure:             f32 = 1.4       @Client    "Exposure multiplier applied before the tonemap curve"

    // Composed as a diffuse term already (floor * albedo), so it does NOT take
    // the 1/PI the lightmapped and analytic paths apply to their irradiance:
    // the default is 0.15/PI (lighting_def.md §9).
    r_ambient_floor:        f32 = 0.0477    @Client    "Constant light added to every surface on top of the baked and probe light, lightmapped or not; all a surface with no chart gets where the probes are dark or absent"

    r_stylized:             bool = true     @Client    "The whole comic look at once: off draws the plain frame whatever r_cel, r_ink and r_cel_fill say"
    r_cel:                  bool = true     @Client    "Shade the whole frame in two tones (shading_cel.glsl); turns PCSS off, which a hard shadow edge cannot use"
    r_cel_terminator:       f32 = 0.05      @Client    "How far a surface must face a light to count as lit, as N.L (0 = edge-on, 1 = face-on)"
    r_cel_shadow_edge:      f32 = 0.5       @Client    "How much of a light a shadow must let through for the surface to count as lit (0 to 1)"
    r_cel_softness:         f32 = 0.03      @Client    "Half the width of the edge between lit and unlit; 0 is a hard step"
    r_cel_shadow_red:       f32 = 0.8       @Client    "Red of the colour the unlit side is multiplied by"
    r_cel_shadow_green:     f32 = 0.85      @Client    "Green of the colour the unlit side is multiplied by"
    r_cel_shadow_blue:      f32 = 1.0       @Client    "Blue of the colour the unlit side is multiplied by"
    r_cel_bands:            f32 = 2.0       @Client    "How many flat steps the light on a surface, direct and ambient together, is cut into per doubling of its brightness; 0 leaves it smooth"
    r_cel_flat_albedo:      f32 = 0.0       @Client    "How far a material's colour is drawn to the mean colour of its whole texture (0 = textured, 1 = one flat colour per material)"
    r_cel_black:            f32 = 0.05      @Client    "Spotted blacks: a shadow whose ambient light is dimmer than this is drawn as solid ink, the end of the dots' tone ramp (0 = none)"
    r_cel_halftone:         f32 = 0.0       @Client    "Both dithers: 0 lets light darken a surface as usual; above 0 the dots alone carry a surface's light, none where it is lit this brightly and covering more of it the dimmer it is"
    r_cel_halftone_paper:   f32 = 1.0       @Client    "With r_cel_halftone above 0: how brightly every surface is drawn between the dots"
    r_cel_fill:             Cel_Fill = .dither3d @Client "What fills the unlit side: none, hatch (diagonal lines), dither3d (dots pinned to the surface that keep their size on screen, written as arithmetic), dither3d_original (runevision's own Dither3D shader and 3D texture)"
    r_cel_fill_strength:    f32 = 0.5       @Client    "How dark the fill's ink is (0 = invisible, 1 = solid ink)"
    r_cel_fill_spacing:     f32 = 5.0       @Client    "Distance in pixels between hatch lines, between dither3d dots in the darkest shadow, or between dither3d_original dots at half tone"
    r_cel_fill_edge:        f32 = 0.5       @Client    "A surface is filled where direct light adds less than this many times its ambient light"
    r_cel_fill_shadow_tone_dark:        f32 = 0.45      @Client    "Both dithers: the share of the DARKEST shadow the dots cover (0 to 0.75)"
    r_cel_fill_shadow_tone_light:  f32 = 0.15      @Client    "Both dithers: the share of the LIGHTEST shadow the dots cover (0 to 0.75); equal to r_cel_fill_shadow_tone_dark is one flat tone"
    r_cel_fill_ambient_dark:  f32 = 0.06    @Client    "Both dithers: a shadow whose ambient light is this dim or dimmer gets r_cel_fill_shadow_tone_dark"
    r_cel_fill_ambient_light: f32 = 0.3     @Client    "Both dithers: a shadow whose ambient light is this bright or brighter gets r_cel_fill_shadow_tone_light"
    r_cel_fill_tone_lit:    f32 = 0.15      @Client    "Both dithers: the share of a LIT surface the dots cover where its light only grazes it, thinning to none where the light arrives square-on (0 to 0.75); 0 leaves the lit side clean"
    r_cel_fill_material:    f32 = 0.5       @Client    "Both dithers: the tone a material's own occlusion and normal map add, lit or not, so dots gather in its cracks and on its bumps (0 to 1); 0 ignores the maps"
    r_cel_hatch_width:      f32 = 1.0       @Client    "hatch: width of a line, in pixels"
    r_cel_dither3d_size_variability:   f32 = 0.0 @Client "dither3d_original: 0 keeps every dot one size and spreads them apart as the tone lightens, 1 keeps the spacing and shrinks them"
    r_cel_dither3d_contrast:           f32 = 1.0 @Client "dither3d_original: how sharp a dot's edge is (0 to 2); 1 is about a pixel of blur"
    r_cel_dither3d_stretch_smoothness: f32 = 1.0 @Client "dither3d_original: how much dots on a surface seen edge-on blur into their flat tone (0 to 2)"
    r_cel_speckle:          f32 = 0.2       @Client    "How dark the sand speckles over every surface are (0 = none, 1 = solid ink)"
    r_cel_speckle_spacing:  f32 = 10.0      @Client    "Distance between speckle lattice points on screen, in pixels; a point holds at most one speckle"
    r_cel_speckle_density:  f32 = 0.33      @Client    "The share of lattice points that hold a speckle (0 to 1)"
    r_cel_speckle_radius:   f32 = 0.15      @Client    "Radius of a speckle as a fraction of the spacing (0 to 0.5); the rest of the half spacing is how far it strays from its lattice point"
    r_cel_pebble:           f32 = 0.0       @Client    "How dark the inked pebble outlines scattered over every surface are (0 = none, 1 = solid ink)"
    r_cel_pebble_spacing:   f32 = 48.0      @Client    "Side of a pebble grid square, in world units; a square holds at most one pebble, pinned to the world"
    r_cel_pebble_density:   f32 = 0.3       @Client    "The share of grid squares that hold a pebble (0 to 1)"
    r_cel_pebble_size:      f32 = 0.25      @Client    "Radius of the largest pebble as a fraction of the spacing (0 to 0.5); the smallest is half that, and the rest of the half spacing is how far one strays from the middle of its square"
    r_cel_pebble_irregularity: f32 = 0.5    @Client    "How far a pebble is from a circle (0 to 1): how squashed it is and how much its outline wobbles"
    r_cel_pebble_width:     f32 = 1.5       @Client    "Width of a pebble's outline, in pixels"
    r_pattern_preview:                Pattern_Kind = .none @Client "Draw one procedural pattern (pattern.glsl) over every surface, to judge it: none, stripes, grid, checks, bricks, chevrons, dots"
    r_pattern_preview_spacing_along:  f32 = 32.0  @Client    "World units from one repeat of the previewed pattern to the next, in the direction stripes repeat, chevrons point and brick courses run"
    r_pattern_preview_spacing_across: f32 = 32.0  @Client    "World units from one repeat of the previewed pattern to the next, across that direction; stripes and chevrons read it only for their wave and their fold"
    r_pattern_preview_angle:          f32 = 0.0   @Client    "How far the previewed pattern is turned on the face, in degrees"
    r_pattern_preview_scroll:         f32 = 0.0   @Client    "How fast the previewed pattern travels along its direction, in world units per second (0 = still)"
    r_pattern_preview_coverage:       f32 = 0.25  @Client    "How much of a repeat is ink (0 to 1): a stripe's, grid line's, mortar joint's or chevron arm's thickness, or a dot's diameter; checks ignore it"
    r_pattern_preview_shape:          f32 = 0.0   @Client    "The one number only the previewed kind reads: stripes waviness, bricks and dots how far each row is shifted (0.5 = classic brick), chevrons how pointed (0 = straight stripes)"
    r_pattern_preview_strength:       f32 = 0.5   @Client    "How far the previewed pattern's ink replaces the surface's colour (0 = invisible, 1 = solid ink)"
    r_pattern_preview_red:            f32 = 0.0   @Client    "Red of the previewed pattern's ink"
    r_pattern_preview_green:          f32 = 0.0   @Client    "Green of the previewed pattern's ink"
    r_pattern_preview_blue:           f32 = 0.0   @Client    "Blue of the previewed pattern's ink"
    r_ink:                  bool = true     @Client    "Draw ink lines where the scene depth jumps (outlines) and where the surface normal turns (creases)"
    r_ink_threshold:        f32 = 4.0       @Client    "How far the depth must jump before an outline is inked; lower draws more lines"
    r_ink_crease_degrees:   f32 = 30.0      @Client    "How far the surface normal, normal map included, must turn between neighbouring pixels before a crease is inked, in degrees; lower draws more lines"
    r_ink_width:            i32 = 1         @Client    "Ink line reach in pixels"
    r_ink_tint:             f32 = 0.0       @Client    "How much of the colour under a line its ink keeps: 0 is black ink, 0.3 a line three tenths as bright as the surface it is drawn over"
    r_ink_on_black:         f32 = 1.0       @Client    "How white a line drawn inside r_cel_black's solid ink is (0 = it stays ink and is lost, 1 = white)"
    r_ink_wobble:           f32 = 1.5      @Client    "How many pixels an ink line strays from the edge it draws, so it wavers like a hand-drawn one (0 = ruler straight)"
    r_ink_wobble_scale:     f32 = 40.0      @Client    "Length of one waver of r_ink_wobble, in pixels"
    r_ink_boil:             f32 = 5.0       @Client    "How many times a second the waver of r_ink_wobble is redrawn (0 = it holds still)"
    r_ink_weight_near:      f32 = 1.0       @Client    "How many times wider than r_ink_width and r_rim_width a line right at the camera is (1 = one width at every distance)"
    r_ink_weight_distance:  f32 = 256.0     @Client    "The distance, in world units, within which a line thickens: at half of it a line is twice as wide, up to r_ink_weight_near"
    r_rim:                  f32 = 0.0       @Client    "Rim light: how far towards white the near side of a depth jump is lit (0 = none, 1 = white); what counts as a jump is r_ink_threshold"
    r_rim_width:            i32 = 3         @Client    "How many pixels in from the edge the rim light reaches; the ink covers the outermost r_ink_width of them"
    r_misprint:             f32 = 1.5       @Client    "Print misregistration: how many pixels the red and the blue of a far surface are drawn to either side of its green, the ink lines staying in place (0 = none)"
    r_misprint_distance:    f32 = 1024.0    @Client    "The distance, in world units, at which r_misprint is reached; a nearer surface is offset in proportion, so what is close stays in register"

    r_flashlight_intensity: f32 = 20.0      @Client    "Brightness of the light a held Flashlight casts down its cone (a placed Reveal_Light_Entity carries its own), as the irradiance it delivers one metre away; 0 casts none and the cone still reveals"
    r_flashlight_red:       f32 = 1.0       @Client    "Red of a Flashlight's light"
    r_flashlight_green:     f32 = 0.95      @Client    "Green of a Flashlight's light"
    r_flashlight_blue:      f32 = 0.85      @Client    "Blue of a Flashlight's light"
    r_flashlight_inner:     f32 = 0.7       @Client    "Where a Flashlight's beam starts to fade towards the edge of its cone, as a fraction of the half-angle (0 fades from the centre, 0.99 is a hard-edged disc)"

    r_fxaa:                 bool = true     @Client    "Antialias the tonemapped and inked frame with FXAA, under the UI"
    r_fxaa_subpixel:        f32 = 0.25      @Client    "How far FXAA softens detail one pixel across (0 = edges only and sharpest, 1 = softest); thin ink lines grey out as it rises"

    r_fog:                  bool = true     @Client    "Draw the fog of every Fog_Volume_Entity"
    r_fog_distance:         f32 = 4096.0    @Client    "How far from the camera the fog grid reaches, in world units; fog past it is not drawn, and a shorter reach is a finer grid"
    r_fog_anisotropy:       f32 = 0.5       @Client    "How much of the light fog scatters carries on the way it was going: 0 glows alike from every side, towards 0.9 a beam glows mostly when you look up it at its light"

    r_look_panel:           bool = false    @Client    "Show the look panel: a slider per comic look cvar, and an export and load of their values as looks/<name>.look"

    // The sky drawn behind the geometry: the NAME of a cubemap_asset (a folder
    // under resources/cubemaps/), empty for none.
    //
    // A name and not an id, the rule a geometry mesh_path and a material folder
    // already follow: the id is for DISCOVERY, storage stays a name, so a map
    // naming a sky this build does not have still loads and simply shows no
    // sky. (An asset-typed cvar is also not representable -- cvar_type_t is
    // f32/i32/u32/bool/string/enum.)
    //
    // @Mirrored rather than @Client because a MAP is what picks a sky, and
    // apply_map_cvars_that_were_supplied_from_the_editor runs on the SERVER: a @Client cvar could never be set by
    // a map's cvars block at all. Mirrored, the server applies the map's line
    // and the existing memcmp broadcast replicates it to every client -- no new
    // message, and a late joiner gets it too.
    sv_skybox:              string<64> = ""  @Mirrored  "Cubemap the map shows as its sky (a folder name under resources/cubemaps/); empty for none"

    debug_show_collisions:  bool = false                "Show collision faces in green"
    debug_show_hitboxes:    bool = true                "Show entity hitboxes in wireframe"
    debug_show_navmesh:     bool = false                "Show baked navmesh as a line grid"
    debug_show_box_volumes: bool = false                "Draw every entity's box volume as a wireframe AABB (triggers, clip volumes, ...)"

    // @Client, unlike the four above: those are unflagged because player_move
    // reads debug_show_collisions on BOTH sides, while these three are view
    // toggles the server has no rendering to apply them to. They were plain
    // Play_State bools, which put three of the seven checkboxes in one HUD
    // block out of the console's reach for no reason.
    debug_hide_geometry:       bool = false @Client     "Skip drawing map geometry"
    // How long a shot-debug pair stays on screen. A shot is one frame and you
    // cannot see 16ms, so the draw has to outlive the frame that made it --
    // debug_draw_list_t entries carry their own lifetime, which is what this
    // feeds. 0 disables the draw without turning off the server's send.
    cl_shot_debug_seconds:     f32 = 4.0 @Client     "Seconds a shot-debug overlay stays on screen (0 = off)"
    debug_show_entity_counts:  bool = false @Client     "Per-type entity count overlay"

    net_snapshot_debug:     bool = false    @Client     "Log each received snapshot's baseline tick and payload size (every 120 ticks)"

    // The pair answers the question actually being asked most of the time --
    // was it fired, and did it arrive -- without a debugger at all, which
    // matters on a dedicated server over a real connection where breakpoints
    // are not an option. Both log through the generated table-driven formatter,
    // so they cover every event with no per-event print code.
    sv_event_debug:         bool = false    @Server     "Log each gameplay event as the server fires it"
    cl_event_debug:         bool = false    @Client     "Log each gameplay event as this client dispatches it"

    // Walks the records pending in each client's reliable stream. The buffer is
    // self-describing, which is why there is no {type, offset, length} index
    // beside it to print instead -- see network/reliable_stream.hpp.
    sv_reliable_debug:      bool = false    @Server     "Log the records pending in each client's reliable stream"

    // The entity I/O counterpart, and it exists for one line in particular: an
    // emit whose sender has NO connections. "I walked into the trigger and
    // nothing happened" has three causes -- the signal never fired, it fired
    // and nothing was wired to it, or it was wired and the action was refused
    // -- and they are indistinguishable from the viewport. Read directly rather
    // than latched the way sv_event_debug is: that latch exists because the
    // GENERATED fire helpers must stay free of the cvar family, and every site
    // here is hand-written server code already holding the context.
    sv_io_debug:            bool = false    @Server     "Log every entity I/O emit, queued record and dispatch"

    // replay_def.md ss4. Unflagged: both recorders read it, each on its own side.
    replay_keyframe_seconds: f32 = 2.0                  "Seconds between full keyframes in a replay recording"
    sv_replay_auto:          bool = false   @Server     "Start a replay recording on every map load"
    sv_ghost_record:         bool = true    @Server     "Write maps/<map>.<n>p.ghost when a run is the fastest of its party size"
}

// ---------------------------------------------------------------------------
// Commands
// ---------------------------------------------------------------------------
//
// A command is a VERB with a SIGNATURE: a name, typed parameters, a handler.
// Declaring one here obligates the owning side to define `commands::<name>`
// with exactly the signature the parameter list implies -- spawn_bot's is
// `void spawn_bot(Bot_Mode mode, const command_context_t&)` -- and the
// generated per-side binder TU references that symbol directly, so a missing,
// misspelled or WRONGLY TYPED handler is a LINK ERROR naming the symbol.
// There is no runtime registration and nothing for the linker to drop.
//
// The handler never sees the console tokens. Its generated ARGUMENT BINDER
// parses them against this signature -- count check, per-type parse, defaults
// -- and on failure replies with a usage string derived from the same
// signature, so usage text cannot drift from what is actually accepted. The
// old shape (every handler takes Span<string_view> and hand-parses) was the
// same disease the cvar migration cured: N copies of tokenize/validate/convert
// drifting against N prose "Usage:" strings.
//
// Parameter types: f32 / i32 / u32 / bool / string / an enum declared in THIS
// file (the entity fence stands -- a command may not name an entity type).
// `string` is bare, no <N>: the value is a view into the console line, not
// stored bytes. A `= default` makes a parameter optional; optional parameters
// form a suffix, because arguments bind by position. `string...` (last
// parameter only) takes the line's untokenized tail, spaces intact.
//
// Enum-typed CVARS are deliberately not implemented -- same rule as string<N>
// above: the machinery exists the day the first declaration needs it.
//
// Names share ONE flat namespace with the cvars above -- the console resolves
// both from the same token, so a collision is a generator error.

// Lowercase values on purpose, unlike the entity family's Pascal_Case: these
// are console-typed identity ("spawn_bot chase"), and everything the console
// resolves is lowercase.
Bot_Mode :: enum { idle, chase, regular }

Server_Commands :: commands {
    spawn_bot(mode: Bot_Mode = .idle)  @Server  "Spawn a bot"
    spawn_cube()                       @Server  "Spawn a physics cube in front of the calling player"
    spawn_sphere()                     @Server  "Spawn a physics sphere in front of the calling player"

    // WAS A CVAR: CVar<std::string> map("map", "dm_aabb", ...) with an
    // on-change callback that loaded the level -- a verb wearing a variable
    // costume. It is a command here, which also removes the only user of the
    // callback mechanism, which is why v1 has no callback mechanism at all.
    // The "current map" question is answered by the server's own state and the
    // CmdChangeMap broadcast, not by a settable string.
    map(path: string)                  @Server  "Switch the server to a new map"

    // Source's setpos: moves the CALLER's body, feet at the point, velocity
    // zeroed. The client fires it when cl_noclip goes off so the body catches
    // up with the camera; three floats because a command parameter has no v3.
    setpos(x: f32, y: f32, z: f32)     @Server  "Move the calling player's body to a position"

    // A client connects as a SPECTATOR -- it holds a slot with no player
    // entity -- and this is what gives it a body. @Server because spawning is
    // the server's to do; the caller is command_context_t::caller_slot, so
    // there is nothing to name and no parameters.
    join_game()                        @Server  "Leave spectate and spawn into the match"
    // A VERB, so a command rather than a cvar -- the same reason `map` stopped
    // being one. There is no spectator state to hold: a client with no
    // player_uid IS a spectator (see "Client vs Player" in CLAUDE.md), so this
    // destroys the body and nothing needs remembering.
    spectate()                         @Server  "Leave the match and return to spectating"

    // The dedicated server's half of mem_report below. A separate name rather
    // than a @Mirrored anything: the audit state is one object per PROCESS, so
    // on the integrated build mem_report already covers both sides, and this
    // exists for the build where there is no client console to type into.
    sv_mem_report(top: i32 = 20)       @Server  "Print the top allocation sites by live bytes"
    // The server's unit is a TICK, not a frame: its loop period is set by the
    // accumulator, so what is measured here is how long a tick took to run.
    sv_frame_report()                  @Server  "Print the tick time distribution and the worst ticks so far"
    sv_hitch_report(top: i32 = 15)     @Server  "What the worst tick allocated, by call site"

    // Source's ent_fire, and the reason it is here BEFORE any level is wired:
    // a wiring system you cannot poke from the console is one you debug by
    // walking into triggers. The action name is a `string` rather than an enum
    // parameter because entity_action lives in the ENTITY family and a cvar may
    // not reference one -- the fence is what forces the handler to resolve it
    // through try_from_string, which is also where the "it accepts these"
    // error comes from.
    //
    // SYNCHRONOUS, unlike a connection: everything from code is, and the
    // console is code. See entity_io_def.md ss7.
    ent_fire(target: u32, action: string, parameters: string... = "")  @Server  "Send an action to one entity, as field=value pairs"

    // The map's Game_Rules_Entity told Restart_Round / End_Match, the caller's
    // body as activator. What a key binds to.
    restart_round()                    @Server  "Restart the current round at the start line"
    end_match()                        @Server  "End the match and go to next_map"

    // Toggles the caller's warmup vote. Refused outside Warmup and for a
    // spectator, who has no body to be ready with.
    ready()                            @Server  "Toggle your ready vote during warmup"

    // The server's world, every tick, no gaps. An empty name is <map>_<date>.
    sv_replay_record(name: string = "") @Server  "Record the running map to replays/<name>.replay"
    sv_replay_stop()                   @Server  "Finish the server's replay recording"
}

Client_Commands :: commands {
    bind(key: string, command: string...)  @Client  "Bind a key (a-z, 0-9, f1-f12, space, arrows, kp_0-kp_9) to a command line"

    // @Client even though it is about the server: it picks WHICH server, so it
    // must run on the side that isn't connected to one yet. Forwarding it would
    // be nonsense -- there is nowhere to forward it to.
    connect(address: string)               @Client  "Connect to a server (ip or ip:port) and enter play"

    // A COMMAND, not a cvar, for the same reason `map` is one: announcing is a
    // verb, and the banner has no "current value" anybody can ask for -- it
    // shows for a few seconds and is gone. A settable string would have to
    // answer "what is it now?" three seconds later, and the honest answer is
    // nothing.
    //
    // `string...` takes the line's untokenized tail, so `announce hello there`
    // shows both words with the spacing intact rather than the first token
    // alone.
    announce(text: string...)              @Client  "Show a banner on screen for a few seconds"

    // The toggle over cl_noclip, so one bound key does both directions.
    noclip()                               @Client  "Toggle the free camera (cl_noclip)"

    // Allocation attribution (vector_def.md, Track A). COMMANDS rather than
    // cvars for the same reason `map` is one: each is a verb that prints
    // something now, and none has a current value anybody could ask for.
    // mem_stacks is the exception that proves it -- it does set a flag, but the
    // flag lives on the audit state the launcher owns, not in cvar_state_t,
    // because a non-audit build has no state for it to sit in.
    //
    // All three print to the TERMINAL, not to the in-game console: a site
    // listing is tens of lines of symbolized stack.
    mem_report(top: i32 = 20)              @Client  "Print the top allocation sites by live bytes"
    mem_frame()                            @Client  "Print how much the last frame allocated"
    mem_stacks(capture: bool = true)       @Client  "Capture a call stack per allocation (off = totals only)"

    // Frame time DISTRIBUTION, not an average -- a hitch is a tail event and a
    // mean is the one statistic that hides it. Unlike the mem_* commands above
    // this works in every build: a QPC read per frame costs nothing, so there
    // is no reason to gate it behind the audit.
    frame_report()                         @Client  "Print the frame time distribution and the worst frames so far"
    frame_reset()                          @Client  "Discard the frame time distribution and start measuring again"

    // What the single worst frame ALLOCATED, by call site. The cumulative
    // mem_report answers "what allocates in this game"; this answers "what
    // happened in frame 8412", which is the question a hitch actually poses.
    // Needs -DTILDE_MEMORY_AUDIT=ON, since the per-site deltas come from there.
    hitch_report(top: i32 = 15)            @Client  "What the worst frame allocated, by call site"

    // What THIS client received, gaps where packets were lost. Works against a
    // server you do not run.
    replay_record(name: string = "")       @Client  "Record what this client receives to replays/<name>.replay"
    replay_play(path: string)              @Client  "Play a .replay file in place of a server"
    replay_stop()                          @Client  "Stop playing a replay, or finish this client's recording"
    replay_pause()                         @Client  "Pause or resume the replay"
    replay_speed(factor: f32)              @Client  "Play the replay at a speed (audio is muted away from 1)"
    replay_seek(seconds: f32)              @Client  "Jump to a time, in seconds from the start of the replay"
    replay_skip(seconds: f32)              @Client  "Jump forward, or back with a negative number of seconds"
}
