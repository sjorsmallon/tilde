Fully_Serializable :: [@Networked, @Editable]

Entity :: base {
    entity_id:   entity                 @Networked
    position:    v3                     @Fully_Serializable
    orientation: quat = {0, 0, 0, 1}    @Fully_Serializable
    name:        string<32>             @Editable
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

Spawn_Type :: enum { Human, Bot }
Team_Allegiance :: enum { Red, Blu, Free_For_All }

Weapon :: enum { Knife, Scout, Rocket_Launcher, Dash, Swapper, Hook, Bubble, Kooh, Magnet, Mock, Platform }
Fire_Resolution :: enum { None, Hitscan, Projectile, Self_Impulse, Zoom }
Fire_Trigger :: enum { Primary, Secondary }
Inventory_Slot :: enum { Primary, Secondary, Melee, Utility_1, Utility_2 }

//@NOTE(SJM): this is a hacky test to embed in weapon_entity, but it's a test.
Damage_Type :: enum { Normal, Orange, Teal }

Shader_Type :: enum { Lit, Unlit, Ghost }
Shape_Kind :: enum { Sphere, Box }
Light_Mode :: enum { Baked, Mixed, Dynamic }

Aim_Pose :: enum { Forward, Upward, Downward, Left, Right }

Round_Phase :: enum { Warmup, Countdown, Freeze, Live, Round_End, Game_Over }
Game_Mode :: enum { deathmatch, rounds, speedrun }
Round_End_Reason :: enum { None, Timeout, Frag_Limit, Team_Elimination, Objective, Requested }
Match_Request :: enum { None, Start_Match, End_Round, Restart_Round, End_Match }

// mover_def.md ss2. Orientation always slerps; this is t alone.
Easing :: enum { Linear, Smooth }

// What is authoring a player's move instead of the model, while it lasts.
// movement_def.md "Overrides": one override, one member. A second kind reuses
// the generic override_* fields below and adds only what none of them says.
Movement_Override :: enum { None, Reel }

// ---------------------------------------------------------------------------
// COMPONENTS
// ---------------------------------------------------------------------------

Box_Volume :: component {
    position: v3 = {0, 0, 0}            @Editable
    half_extents: v3 = {1, 1, 1}        @Editable
}

Enabled :: component {
    value: bool = true                  @Fully_Serializable
}

Playback :: component {
    play_count: u32 = 0                 @Networked
    stop_count: u32 = 0                 @Networked
}

// The flight every fired entity shares; what happens on contact is the type's own system.
Projectile :: component {
    // The WEAPON_DEFINITIONS row that fired it: its projectile_t is how this flies.
    weapon_id: Weapon = .Rocket_Launcher @Networked
    // Which of the row's two fires it came off: the other half of how it flies.
    trigger:   Fire_Trigger              @Networked
    velocity:  v3                        @Networked
    owner_uid: entity
}

// A flight decided ONCE, at launch, so every later position is a pure function of the tick.
Fixed_Arc_Flight :: component {
    launch_position: v3                 @Networked
    // 0 until the type's system fixes the arc, in the tick it was fired.
    launch_tick:     u32                @Networked
    flight_ticks:    u32                @Networked
}

Health :: component {
    current_health: i32 = 100   @Fully_Serializable
    max_health: i32 = 100       @Editable
}

Counter :: component {
    value: i32 = 0                  @Editable
    limit: i32 = 0                  @Editable
}

Material :: component {
    shader_type: Shader_Type = .Lit     @Fully_Serializable
    color:       v3 = {1, 1, 1}         @Fully_Serializable
}

Render :: component {
    mesh:         mesh_asset = .Missing @Fully_Serializable
    visible:      bool = true           @Fully_Serializable
    is_wireframe: bool = false          @Fully_Serializable
    offset:       v3 = {0, 0, 0}        @Fully_Serializable
    scale:        v3 = {1, 1, 1}        @Fully_Serializable
    rotation:     quat = {0, 0, 0, 1}   @Fully_Serializable
    material:     Material
}

Light :: component {
    color:     v3 = {1, 1, 1}       @Fully_Serializable

    // irradiance it delivers at one meter.
    intensity: f32 = 1.0            @Editable
    mode:      Light_Mode = .Baked  @Editable

    // this is _NOT_ the reach of the light: this is if you want a sun.
    source_radius: f32 = 0.0        @Editable
    casts_shadows: bool = true      @Editable
}

Movement :: component {
    air_jumps_used: u8                  @Networked
    is_grounded: bool                   @Networked
    time_since_grounded_seconds: f32    @Networked
    jump_was_held: bool                 @Networked
    seconds_until_impulse_ready: f32    @Networked
    seconds_until_speed_returns_to_base_speed: f32  @Networked

    // pm_model instant_momentum's memory: the horizontal speed the body
    // CARRIES, which is where an impulse lands under that model and what its
    // drag bleeds. Zero under every other model, which owns its own memory.
    momentum: v3                        @Networked

    pad_contact_uid: u32                @Networked
    ground_mover_uid: entity            @Networked

    // An override replaces the MODEL while it is live and exits as an impulse.
    // The numbers are written AT ATTACH by whoever attaches, so player_move
    // reads no hook cvar and the client predicts a reel from state it holds.
    // The uid is what the attacher refreshes the position from per tick,
    // because player_move is pure and cannot resolve one.
    active_override: Movement_Override = .None  @Networked
    override_target_uid: entity                 @Networked
    override_target_position: v3                @Networked
    override_seconds_remaining: f32             @Networked
    override_speed: f32                         @Networked
    override_arrive_radius: f32                 @Networked
}

Inventory :: component {
    weapons:              u32[Inventory_Slot]      @Networked
    active_slot:          Inventory_Slot = .Melee  @Networked
    deploy_complete_time: u64
}

Timer_State :: component {
    duration_seconds: f32 = 1.0   @Editable
    repeat: bool = false          @Editable
    running: bool = false                 @Networked
    deadline_tick: u32 = 0                @Networked
    paused_remaining_ticks: u32 = 0       @Networked
}

// The match itself. `requested` is the one field a handler writes; the rules
// system pays it at its own step, since a transition spawns and emits.
Match :: component {
    mode:              Game_Mode = .deathmatch          @Fully_Serializable
    phase:             Round_Phase = .Warmup            @Networked
    phase_start_tick:  u32 = 0                          @Networked
    phase_end_tick:    u32 = 0                          @Networked
    round_number:      u32 = 0                          @Networked
    end_reason:        Round_End_Reason = .None         @Networked
    winning_team:      Team_Allegiance = .Free_For_All  @Networked
    objective_reached: bool = false                     @Networked
    // The map this one replaced had a started match: no vote, it starts once every joined client holds the map.
    starts_when_loaded: bool = false                    @Networked
    requested:         Match_Request = .None
}

// A trajectory, never a position: the node last left and when (mover_def.md ss3).
Path_Follow :: component {
    from:               entity      @Fully_Serializable
    segment_start_tick: u32 = 0     @Networked
    direction:          i32 = 1     @Networked
    frozen_at_tick:     u32 = 0     @Networked
}

// ---------------------------------------------------------------------------
// TRAITS -- entity_io_def.md ss5
// ---------------------------------------------------------------------------
// A trait is a named set of ACTIONS a type can be told and SIGNALS it
// announces. A TYPE-level fact, opted into by an entity's `is` list; the
// per-INSTANCE half is a connection, which is map data and lives nowhere in
// here. `requires C` means the trait's handlers are written ONCE against that
// component and every opting-in type must carry one; `by` names the types that
// can activate a signal, which is what a connection targeting the activator is
// checked against at load.
//
// A verb belongs to exactly one trait, and the two kinds share one namespace:
// each emits a `<Name>_Data` payload struct.

// I was thinking about the emit syntax here. Accepts is simple: it's an interface definition.
// the problem arises with emits: when do they emit? for some things like the counting, it's trivial
// to do in the add. However, damage can optionally emit died, kill would emit died, and set_health and damage
// could emit that. Additionally, this is all in the basic case: not in the per-entity case.
//
// IDEA, not built: an action names the signals it MAY cause, and the handler RETURNS them.
//
//     accepts Add(amount: i32) -> Limit_Reached
//
// generates `[[nodiscard]] std::optional<Limit_Reached_Data> add(...)`, and the generated
// dispatcher emits whatever comes back, under the context the handler was called with. Several
// signals (`-> Health_Changed, Died`) return a struct of optionals, emitted in declaration order.
// The .def states a RELATION (this action can cause that signal), never a condition: WHEN stays
// in C++, so there is no expression language to grow. A per-entity handler that never wants the
// signal returns nullopt. An action with no `->` does not make its state true by returning (a
// door is not open when Open() returns); a system emits for it later through emit_<signal>, as
// Elapsed, Touched and the match signals do. Anything that fits neither is a hint that it is
// due for something else.

Switchable :: trait requires Enabled {
    accepts Enable(), Disable(), Toggle_Enabled()
}

Playable :: trait requires Playback {
    accepts Play(), Stop_Playing()
}

Colorable :: trait {
    accepts Set_Color(color: v3)
    emits   Color_Changed(color: v3)
}

Counting :: trait requires Counter {
    accepts Add(amount: i32), Reset()
    emits Limit_Reached(), Fell_Below_Limit()
}

Touchable :: trait requires Box_Volume, Enabled {
    emits Touched(), Left()
    by    Player_Entity, Physics_Body_Entity
}

Mortal :: trait requires Health {
    accepts Kill(), Set_Health(amount: i32), Damage(amount: i32)
    emits   Died(killer: entity), Health_Changed(health: i32)
}

Mobile :: trait {
    accepts Teleport(destination: entity, keep_velocity: bool),
            Set_Velocity(velocity: v3),
            Add_Velocity(velocity: v3)
}

Armable :: trait requires Inventory {
    accepts Grant_Weapon(weapon: Weapon, damage_type: Damage_Type)
}

Respawnable :: trait {
    accepts Set_Respawn_Point(location: entity)
}

Objective :: trait {
    accepts Complete_Level()
}

Timer :: trait requires Timer_State {
    accepts Start(), Stop(), Restart(), Pause(), Resume()
    emits   Elapsed()
}

Match_Control :: trait requires Match {
    accepts Start_Match(), End_Round(), Restart_Round(), End_Match()
    emits   Match_Started(), Round_Started(), Round_Ended(reason: Round_End_Reason), Match_Ended()
}

Path_Following :: trait requires Path_Follow {
    accepts Reverse(), Go_To(node: entity)
    emits   Node_Reached(node: entity)
}

Firing :: trait {
    accepts Fire()
}


// ---------------------------------------------------------------------------
// ENTITIES - note that declaration order is sacred. or: if you break it,
// you have to repair a lot of places, which the compiler will tell you at least, but is annoying as fuck.
// ---------------------------------------------------------------------------

Player_Spawn_Entity :: entity {
    spawn_type: Spawn_Type = .Human     @Editable
    team_allegiance: Team_Allegiance = .Free_For_All @Editable
}

// this looks empty but that's because all the entity fields are good enough.
Player_Spectate_Entity :: entity {
}

Player_Entity :: entity @runtime_only is Mortal, Mobile, Armable, Respawnable {
    // The remote player's model is oriented from these, so they replicate.
    view_angle_yaw:    f32              @Networked
    view_angle_pitch:  f32              @Networked
    body_yaw:          f32              @Networked

    health:            Health = {current_health = 100, max_health = 100}

    death_tick:        u32              @Networked
    last_fire_tick:    u32              @Networked
    last_fire_weapon:  Weapon = .Knife  @Networked

    // WHEN the in-flight reload finishes, in sub-tick time; 0 means not
    // reloading. A DEADLINE rather than a start stamp, because the duration is
    // a property of the weapon being reloaded and the weapon can change while
    // the reload runs -- at a sub-tick moment inside the same step loop, now
    // that the weapon keys carry edges. Storing the start would leave "whose
    // duration applies" to be re-decided every tick against a weapon that is no
    // longer the one being reloaded; storing the deadline settles it at the
    // moment the input arrived, which is the only moment that knows.
    reload_complete_time: u64

    // Rate limit for the empty-magazine warning. Server-only, like the two
    // above: a log cadence is not something a client has any use for.
    last_empty_fire_warning_tick: u32

    // Where a death respawn puts you, from Set_Respawn_Point; 0 for none.
    checkpoint_uid: entity

    last_hit_tick:         u32          @Networked
    last_hit_was_headshot: bool         @Networked

    // How a client works out which player entity is itself.
    client_slot_index: i32              @Networked
    ready: bool                         @Networked
    // Jump pressed during this Freeze; the round boundary's player reset clears it.
    wants_to_skip_freeze: bool          @Networked
    display_name: string<32>            @Networked

    // The scoreboard. Awarded at the one health crossing in damage.cpp.
    kills:  i32                         @Networked
    deaths: i32                         @Networked
    velocity:          v3               @Networked
    inventory:         Inventory
    movement:          Movement

    render:            Render = { mesh = .Leet_Full }
    team_allegiance: Team_Allegiance = .Free_For_All @Networked
}

Weapon_Entity :: entity {
    // In the magazine, and what a reload draws from. Negative is unlimited.
    ammo:             i32 = -1          @Fully_Serializable
    reserve_ammo:     i32 = -1          @Fully_Serializable
    weapon_id:        Weapon            @Fully_Serializable
    // Null owner means the weapon lies in the world as a physics body, waiting to be picked up.
    owner_uid:        entity            @Networked
    next_fire_time:   u64
    pickup_allowed_tick: u32
    damage_type: Damage_Type = .Normal  @Editable
    // The pickup reach and the thrown physics box.
    volume:           Box_Volume = { half_extents = {40, 40, 40} }
    render:           Render = { mesh = .Error }
}

Rocket_Entity :: entity @runtime_only {
    projectile: Projectile = { weapon_id = .Rocket_Launcher }
    lifetime: f32 = 5.0
    damage_amount: f32 = 50.0
    damage_radius: f32 = 120.0
    knockback_force: f32 = 600.0
    collision_radius: f32 = 12.0        @Networked
    render:          Render = { mesh = .rocket}
}

Hook_Entity :: entity @runtime_only {
    projectile:      Projectile = { weapon_id = .Hook }
    lifetime:         f32 = 4
    collision_radius: f32 = 25.0
    // Set by the secondary trigger: reels the victim in over time instead of throwing them once.
    reels_target:     bool
    render:           Render = { mesh = .hookshot, scale = {0.03, 0.03, 0.03} }
}

Kooh_Entity:: entity @runtime_only {
    projectile:       Projectile = { weapon_id = .Kooh }
    lifetime: f32 = 4.0
    collision_radius: f32 = 25.0
    // 
    reels_player:     bool
    render:           Render = { mesh = .hookshot, scale = {0.03,0.03,0.03}}
}

// A ghost while it flies, a solid box from the tick it lands until rest_seconds later (shared/spawned_platforms.hpp).
Platform_Entity :: entity @runtime_only @predicted {
    projectile:     Projectile = { weapon_id = .Platform }
    flight:         Fixed_Arc_Flight
    flight_seconds: f32 = 0.6
    rest_seconds:   f32 = 6.0
    half_extents:   v3 = {64, 4, 64}
    // Drawn at half_extents, never at render.scale.
    render:         Render = { mesh = .Box, material = { color = {1, 0.75, 0.3} } }
}

Bubble_Entity :: entity @runtime_only @predicted {
    projectile:      Projectile = { weapon_id = .Bubble }
    flight:          Fixed_Arc_Flight
    // 0 while whole. A popped bubble bounces nobody, draws nothing, and is reaped linger_seconds later.
    popped_tick:     u32                @Networked
    // Whoever bounced on it, who heard the pop off their own predicted step; null when it timed out.
    popped_by:       entity             @Networked
    linger_seconds:  f32 = 0.25
    flight_seconds:  f32 = 1.0
    rest_seconds:    f32 = 8.0

    // there's some immunity after firing so you don't instantly get bounced.
    arm_seconds:     f32 = 0.2
    radius:          f32 = 32.0
    bounce_speed:    f32 = 700.0

    render:          Render = { mesh = .Sphere, scale = {64, 64, 64}, material = { shader_type = .Ghost, color = {0.55, 0.85, 1} } }
}

Physics_Body_Entity :: entity {
    // Jolt's shape and the editor's size box. Server-side simulation input;
    // the visual size rides in render.scale, which the spawn path sets from
    // the same extents.
    shape:    Shape_Kind = .Box         @Editable
    size:     v3                        @Editable
    // Kept @Networked for the interpolation item in todo.md: bodies currently
    // snap to each snapshot, and velocity is what a lerp/extrapolate needs.
    velocity: v3                        @Networked
    mass:     f32 = 10.0                @Editable
    render:   Render
}

// volume is the hitbox.
Damageable_Entity :: entity is Mortal {
    health:   Health
    volume:   Box_Volume = { half_extents = {16, 32, 16} }
    weakness: Damage_Type = .Orange          @Editable
    render:   Render
}

Particle_Emitter_Entity :: entity {
    sprite:             texture_asset = .Smoke @Editable
    emit_rate:          f32 = 20.0            @Editable
    max_particles:      i32 = 64              @Editable
    lifetime_min:       f32 = 0.5             @Editable
    lifetime_max:       f32 = 1.5             @Editable
    velocity_min:       f32 = 2.0             @Editable
    velocity_max:       f32 = 5.0             @Editable
    spread:             f32 = 0.5             @Editable
    gravity:            v3 = {0, 0.5, 0}      @Editable
    drag:               f32 = 0.3             @Editable
    size_start:         f32 = 0.5             @Editable
    size_end:           f32 = 2.0             @Editable
    rotation_speed_min: f32 = -1.0            @Editable
    rotation_speed_max: f32 = 1.0             @Editable
    color_start:        v3 = {1, 1, 1}        @Editable
    color_end:          v3 = {0.5, 0.5, 0.5}  @Editable
    alpha_start:        f32 = 0.8             @Editable
    alpha_end:          f32 = 0.0             @Editable
}

Sound_Emitter_Entity :: entity is Switchable, Playable {
    switch_state: Enabled
    playback:     Playback
    sound:        sound_asset          @Editable
    volume:       f32 = 1.0            @Editable
    loop:         bool = false         @Editable
    spatial:      bool = true          @Editable
    range:        f32 = 1024.0         @Editable
}

Point_Light_Entity :: entity is Colorable, Switchable {
    switch_state:      Enabled
    light: Light
    // Where the falloff reaches zero, in engine units -- 1 unit = 1 inch, the
    // scale player_constants.hpp's 32x32x72 hull fixes. So 256 is a 21-foot
    // (6.5m) radius: one room, two editor grid cells. Between Godot's 5m
    // OmniLight3D default and Unreal's 10m PointLight one, and deliberately
    // smaller than the spot below, which is a directed beam rather than a bulb.
    //
    // Do NOT read the scale off g_gravity: 800 is arcade gravity, ~2x real, and
    // the only constant here that does not respect the inch mapping.
    range: f32 = 256.0                  @Editable
}

Spot_Light_Entity :: entity is Colorable, Switchable {
    switch_state:      Enabled
    light:         Light
    // 512 units = 42 feet (13m): a beam down a corridor rather than a room.
    range:         f32 = 512.0          @Editable
    // HALF-angle in degrees, measured from the cone axis -- which is what
    // pbr.frag's `dot(-L, direction)` compares against, and what Unreal and
    // Godot both mean by a spot angle. Inner is where falloff starts, outer
    // where it reaches zero; inner > outer inverts the gradient rather than
    // being rejected, and the editor cone draws what the value says.
    inner_degrees: f32 = 20.0           @Editable
    outer_degrees: f32 = 35.0           @Editable
}

// No range and no position falloff -- a directional light is a direction and a
// colour. It still has a `position`, inherited from the base, and the editor
// draws its gizmo there; nothing shading reads it.
Directional_Light_Entity :: entity {
    light: Light
    // The FULL angle the disc of the emitter subtends, in degrees -- the sun is
    // 0.53 in reality, and an overcast sky is effectively the whole hemisphere.
    // A directional light has no position for a radius to be measured from, so
    // this is what Light::source_radius is for every other kind: the same
    // geometry with the distance divided out.
    //
    // Zero is the hard parallel sun this had before, so no map converts and a
    // bake pays for extra shadow rays only where an author asked for softness.
    angular_diameter_degrees: f32 = 0.0     @Editable
}

Trigger_Volume_Entity :: entity is Switchable, Touchable {
    switch_state:      Enabled
    volume:            Box_Volume = { half_extents = {64, 64, 64} }
}

Jump_Pad_Entity :: entity @predicted is Switchable, Touchable {
    switch_state:  Enabled
    volume:        Box_Volume = { half_extents = {32, 8, 32} }
    launch_speed:  f32 = 900   @Editable
    render: Render = {mesh = .Duck}
}

Reflection_Volume_Entity :: entity {
    volume: Box_Volume = { half_extents = {256, 256, 256} }
}

Game_Rules_Entity :: entity is Objective, Match_Control {
    match: Match
}

Logic_Counter_Entity :: entity is Counting {
    counter: Counter
}

// this is used to switch geometry on and off.
// the wipe timer is for the clock wipe of the clock. not really nice, but it's whatever.
Geometry_Owner_Entity :: entity @predicted is Switchable {
    switch_state: Enabled
    wipe_timer: entity @Editable
}

// middle-mouse button ping.
Ping_Marker_Entity :: entity @runtime_only {
    lifetime: f32 = 10.0
    pinged_by: entity
    render: Render = { mesh = .Duck }
}

Logic_Timer_Entity :: entity is Timer {
    timer: Timer_State
}

// A path is what `next` looks like from above; previous is derived (mover_def.md ss2).
Path_Node_Entity :: entity {
    next:              entity               @Editable
    traversal_seconds: f32 = 1.0            @Editable
    wait_seconds:      f32 = 0.0            @Editable
    easing:            Easing = .Linear     @Editable
}

Mover_Entity :: entity @predicted is Switchable, Path_Following {
    switch_state: Enabled
    follow:       Path_Follow
}

// Fires the weapon row's projectile along its orientation, once per Fire. The cadence is wiring: a Logic_Timer's Elapsed.
Launcher_Entity :: entity is Switchable, Firing {
    switch_state: Enabled
    weapon:       Weapon = .Bubble          @Editable
    trigger:      Fire_Trigger = .Primary   @Editable
    // Half-angles, each side of the aim. Derived from (uid, shots_fired), so every attempt sees the same pattern.
    spread_yaw_degrees:   f32 = 0.0         @Editable
    spread_pitch_degrees: f32 = 0.0         @Editable
    shots_fired:  u32
    render:       Render = { mesh = .Box, scale = {16, 16, 16} }
}

// Scales the movement settings of a hull that OPENS a step inside it. 1 changes nothing, a negative gravity falls up.
Movement_Modifier_Entity :: entity @predicted is Switchable, Touchable {
    switch_state:     Enabled
    volume:           Box_Volume = { half_extents = {128, 128, 128} }
    gravity_scale:    f32 = 1.0   @Editable
    run_speed_scale:  f32 = 1.0   @Editable
    jump_speed_scale: f32 = 1.0   @Editable
    friction_scale:   f32 = 1.0   @Editable
    control_scale:    f32 = 1.0   @Editable
}
