Fully_Serializable :: [@Networked, @Editable]

Entity :: base {
    entity_id:   u32                    @Networked
    position:    v3                     @Fully_Serializable
    orientation: quat = {0, 0, 0, 1}    @Fully_Serializable
    name:        string<32>             @Editable
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

Spawn_Type :: enum { Human, Bot }
Team_Allegiance :: enum { Red, Blu, Free_For_All }

Weapon :: enum { Knife, Scout, Rocket_Launcher, Dash, Swapper }
Fire_Resolution :: enum { Hitscan, Projectile, Self_Impulse }
Inventory_Slot :: enum { Primary, Secondary, Melee, Utility_1, Utility_2 }

//@NOTE(SJM): this is a hacky test to embed in weapon_entity, but it's a test.
Damage_Type :: enum { Normal, Orange, Teal }

Shader_Type :: enum { Lit, Unlit }
Shape_Kind :: enum { Sphere, Box }
Light_Mode :: enum { Baked, Mixed, Dynamic }

Aim_Pose :: enum { Forward, Upward, Downward, Left, Right }

// ---------------------------------------------------------------------------
// COMPONENTS
// ---------------------------------------------------------------------------

Box_Volume :: component {
    position: v3 = {0, 0, 0}            @Editable
    half_extents: v3 = {1, 1, 1}        @Editable
}

Enabled :: component {
    value: bool = true                  @Fully_Serializable
}

Playback :: component {
    play_count: u32 = 0                 @Networked
}

Health :: component {
    current_health: i32 = 100   @Fully_Serializable
    max_health: i32 = 100       @Editable
}

Counter :: component {
    value: i32 = 0                  @Editable
    limit: i32 = 0                  @Editable
}

Material :: component {
    shader_type: Shader_Type = .Lit     @Fully_Serializable
    color:       v3 = {1, 1, 1}         @Fully_Serializable
}

Render :: component {
    mesh:         mesh_asset = .Missing @Fully_Serializable
    visible:      bool = true           @Fully_Serializable
    is_wireframe: bool = false          @Fully_Serializable
    offset:       v3 = {0, 0, 0}        @Fully_Serializable
    scale:        v3 = {1, 1, 1}        @Fully_Serializable
    rotation:     quat = {0, 0, 0, 1}   @Fully_Serializable
    material:     Material
}

Light :: component {
    color:     v3 = {1, 1, 1}       @Fully_Serializable

    // irradiance it delivers at one meter.
    intensity: f32 = 1.0            @Editable
    mode:      Light_Mode = .Baked  @Editable

    // this is _NOT_ the reach of the light: this is if you want a sun.
    source_radius: f32 = 0.0        @Editable
    casts_shadows: bool = true      @Editable
}

Movement :: component {
    air_jumps_used: u8                  @Networked
    is_grounded: bool                   @Networked
    time_since_grounded_seconds: f32    @Networked
    jump_was_held: bool                 @Networked
    seconds_until_impulse_ready: f32    @Networked

    // Quake 3's jumppad_ent: WHICH movement volume last launched us, so a pad
    // fires once per contact rather than every step you are inside it. A uid
    // and not a bool, because a bool says "I am on a pad" and the uid says
    // which -- so stepping from one pad straight onto another fires twice, and
    // the clear condition is checkable against the volume list.
    pad_contact_uid: u32                @Networked
}

Inventory :: component {
    weapons:              u32[Inventory_Slot]      @Networked
    active_slot:          Inventory_Slot = .Melee  @Networked
    deploy_complete_time: u64
}

// ---------------------------------------------------------------------------
// TRAITS -- entity_io_def.md ss5
// ---------------------------------------------------------------------------
// A trait is a named set of ACTIONS a type can be told and SIGNALS it
// announces. A TYPE-level fact, opted into by an entity's `is` list; the
// per-INSTANCE half is a connection, which is map data and lives nowhere in
// here. `requires C` means the trait's handlers are written ONCE against that
// component and every opting-in type must carry one; `by` names the types that
// can activate a signal, which is what a connection targeting the activator is
// checked against at load.
//
// A verb belongs to exactly one trait, and the two kinds share one namespace:
// each emits a `<Name>_Data` payload struct.

Switchable :: trait requires Enabled {
    accepts Enable(), Disable(), Toggle_Enabled()
}

Playable :: trait requires Playback {
    accepts Play()
}

Colorable :: trait {
    accepts Set_Color(color: v3)
    emits   Color_Changed(color: v3)
}

Counting :: trait requires Counter {
    accepts Add(amount: i32), Reset()
    emits Limit_Reached()
}

Touchable :: trait {
    emits Touched(), Left()
    by    Player_Entity, Physics_Body_Entity
}

Mortal :: trait requires Health {
    accepts Kill(), Set_Health(amount: i32), Damage(amount: i32)
    emits   Died(killer: entity), Health_Changed(health: i32)
}

Mobile :: trait {
    accepts Teleport(destination: entity, keep_velocity: bool),
            Set_Velocity(velocity: v3),
            Add_Velocity(velocity: v3)
}

Armable :: trait requires Inventory {
    accepts Grant_Weapon(weapon: Weapon, damage_type: Damage_Type)
}

Respawnable :: trait {
    accepts Set_Respawn_Point(location: entity)
}

Objective :: trait {
    accepts Complete_Level()
}

// ---------------------------------------------------------------------------
// ENTITIES -- declaration order IS entity_type order: the placement menu, the
// hand-written switches and SCHEMA_HASH all follow it.
// @replicated: rides the snapshot. @predicted: player_move reads it on both
// sides, so it must be @replicated (generalization_def.md ss6).
// ---------------------------------------------------------------------------

Player_Spawn_Entity :: entity {
    spawn_type: Spawn_Type = .Human     @Editable
    team_allegiance: Team_Allegiance = .Free_For_All @Editable
}

Player_Spectate_Entity :: entity {
}

Player_Entity :: entity @runtime_only @replicated is Mortal, Mobile, Armable, Respawnable {
    // The remote player's model is oriented from these, so they replicate.
    view_angle_yaw:    f32              @Networked
    view_angle_pitch:  f32              @Networked
    body_yaw:          f32              @Networked

    health:            Health

    death_tick:        u32              @Networked
    last_fire_tick:    u32              @Networked
    last_fire_weapon:  Weapon = .Knife  @Networked

    // WHEN the in-flight reload finishes, in sub-tick time; 0 means not
    // reloading. A DEADLINE rather than a start stamp, because the duration is
    // a property of the weapon being reloaded and the weapon can change while
    // the reload runs -- at a sub-tick moment inside the same step loop, now
    // that the weapon keys carry edges. Storing the start would leave "whose
    // duration applies" to be re-decided every tick against a weapon that is no
    // longer the one being reloaded; storing the deadline settles it at the
    // moment the input arrived, which is the only moment that knows.
    reload_complete_time: u64

    // Rate limit for the empty-magazine warning. Server-only, like the two
    // above: a log cadence is not something a client has any use for.
    last_empty_fire_warning_tick: u32

    // Where a death respawn puts you, from Set_Respawn_Point; 0 for none.
    checkpoint_uid: u32

    last_hit_tick:         u32          @Networked
    last_hit_was_headshot: bool         @Networked

    // How a client works out which player entity is itself.
    client_slot_index: i32              @Networked

    // Display name, sanitized from CmdConnect at the connect site. On the
    // ENTITY rather than in a message of its own so a late joiner gets every
    // name in its first full snapshot, with no backlog to replay -- and so a
    // bot, which has no client, still has a name.
    //
    // NOT base Entity's `name`, which is the author's map label: this one is
    // negotiated at connect and replicates, that one is authored and does not.
    // A Player is @runtime_only and never sits in a map, so its label is
    // always empty -- which is why these are two fields and not one.
    display_name: string<32>            @Networked

    // The scoreboard, and the only score the wire carries: team score changes
    // once per phase and rides Round_Phase_Changed instead. Awarded at the
    // one health crossing in damage.cpp.
    kills:  i32                         @Networked
    deaths: i32                         @Networked
    // Feeds remote-player interpolation.
    velocity:          v3               @Networked

    inventory:         Inventory

    // Per-player movement state. Sits beside velocity rather than inside it
    // because velocity is what the world does to you and this is what you may
    // still do to the world.
    movement:          Movement

    render:            Render = { mesh = .Leet_Full }
    team_allegiance: Team_Allegiance = .Free_For_All @Networked
}

Weapon_Entity :: entity @replicated {
    ammo:             i32               @Networked
    weapon_id:        Weapon            @Fully_Serializable
    // Null owner means the weapon lies in the world as a physics body, waiting to be picked up.
    owner_uid:        u32               @Networked
    next_fire_time:   u64
    pickup_allowed_tick: u32
    damage_type: Damage_Type = .Normal  @Editable
    render:           Render = { mesh = .Box }
}

Rocket_Entity :: entity @runtime_only @replicated {
    velocity:        v3                 @Networked
    lifetime: f32 = 5.0
    damage_amount: f32 = 50.0
    damage_radius: f32 = 120.0
    knockback_force: f32 = 600.0
    owner_id:        u32
    collision_radius: f32 = 12.0        @Networked
    render:          Render
}

// Both map-placed AND runtime-spawned (the spawn_cube / spawn_sphere console
// commands), which is why its Render component has to be @Networked while its
// own configuration does not: play_state.cpp draws a body from
// body.position / body.orientation / body.render and reads nothing else off it.
Physics_Body_Entity :: entity @replicated {
    // Jolt's shape and the editor's size box. Server-side simulation input;
    // the visual size rides in render.scale, which the spawn path sets from
    // the same extents.
    shape:    Shape_Kind = .Box         @Editable
    size:     v3                        @Editable
    // Kept @Networked for the interpolation item in todo.md: bodies currently
    // snap to each snapshot, and velocity is what a lerp/extrapolate needs.
    velocity: v3                        @Networked
    mass:     f32 = 10.0                @Editable
    render:   Render
}

Damageable_Entity :: entity @replicated is Mortal {
    health: Health
    hitbox_half_extents: v3 = {16, 32, 16}   @Editable
    weakness: Damage_Type = .Orange          @Editable
    render:            Render
}

Particle_Emitter_Entity :: entity {
    sprite:             texture_asset = .Smoke @Editable
    emit_rate:          f32 = 20.0            @Editable
    max_particles:      i32 = 64              @Editable
    lifetime_min:       f32 = 0.5             @Editable
    lifetime_max:       f32 = 1.5             @Editable
    velocity_min:       f32 = 2.0             @Editable
    velocity_max:       f32 = 5.0             @Editable
    spread:             f32 = 0.5             @Editable
    gravity:            v3 = {0, 0.5, 0}      @Editable
    drag:               f32 = 0.3             @Editable
    size_start:         f32 = 0.5             @Editable
    size_end:           f32 = 2.0             @Editable
    rotation_speed_min: f32 = -1.0            @Editable
    rotation_speed_max: f32 = 1.0             @Editable
    color_start:        v3 = {1, 1, 1}        @Editable
    color_end:          v3 = {0.5, 0.5, 0.5}  @Editable
    alpha_start:        f32 = 0.8             @Editable
    alpha_end:          f32 = 0.0             @Editable
}

// The third map-placed receiver after the two lights, and the ONE place a
// sound is authored per instance: an emitter's identity is its sound the way a
// static mesh's is its mesh path. The switch is a MUTE for a one-shot (Play on
// a disabled emitter does nothing) and the level for a loop. `spatial` off is
// everyone's ears -- an announcer, music -- never one player's; that is a
// state edge on the player, not an emitter. Loops are NOT built yet: the
// client warns once and stays silent, hence the default is a one-shot.
Sound_Emitter_Entity :: entity @replicated is Switchable, Playable {
    switch_state: Enabled
    playback:     Playback
    sound:        sound_asset          @Editable
    volume:       f32 = 1.0            @Editable
    loop:         bool = false         @Editable
    spatial:      bool = true          @Editable
    range:        f32 = 1024.0         @Editable
}

Point_Light_Entity :: entity @replicated is Colorable, Switchable {
    switch_state:      Enabled
    light: Light
    // Where the falloff reaches zero, in engine units -- 1 unit = 1 inch, the
    // scale player_constants.hpp's 32x32x72 hull fixes. So 256 is a 21-foot
    // (6.5m) radius: one room, two editor grid cells. Between Godot's 5m
    // OmniLight3D default and Unreal's 10m PointLight one, and deliberately
    // smaller than the spot below, which is a directed beam rather than a bulb.
    //
    // Do NOT read the scale off g_gravity: 800 is arcade gravity, ~2x real, and
    // the only constant here that does not respect the inch mapping.
    range: f32 = 256.0                  @Editable
}

Spot_Light_Entity :: entity @replicated is Colorable, Switchable {
    switch_state:      Enabled
    light:         Light
    // 512 units = 42 feet (13m): a beam down a corridor rather than a room.
    range:         f32 = 512.0          @Editable
    // HALF-angle in degrees, measured from the cone axis -- which is what
    // pbr.frag's `dot(-L, direction)` compares against, and what Unreal and
    // Godot both mean by a spot angle. Inner is where falloff starts, outer
    // where it reaches zero; inner > outer inverts the gradient rather than
    // being rejected, and the editor cone draws what the value says.
    inner_degrees: f32 = 20.0           @Editable
    outer_degrees: f32 = 35.0           @Editable
}

// No range and no position falloff -- a directional light is a direction and a
// colour. It still has a `position`, inherited from the base, and the editor
// draws its gizmo there; nothing shading reads it.
Directional_Light_Entity :: entity {
    light: Light
    // The FULL angle the disc of the emitter subtends, in degrees -- the sun is
    // 0.53 in reality, and an overcast sky is effectively the whole hemisphere.
    // A directional light has no position for a radius to be measured from, so
    // this is what Light::source_radius is for every other kind: the same
    // geometry with the distance divided out.
    //
    // Zero is the hard parallel sun this had before, so no map converts and a
    // bake pays for extra shadow rays only where an author asked for softness.
    angular_diameter_degrees: f32 = 0.0     @Editable
}

Trigger_Volume_Entity :: entity is Switchable, Touchable {
    switch_state:      Enabled
    volume:            Box_Volume = { half_extents = {64, 64, 64} }
}

Jump_Pad_Entity :: entity @replicated @predicted is Switchable, Touchable {
    switch_state:  Enabled
    volume:        Box_Volume = { half_extents = {32, 8, 32} }
    launch_speed:  f32 = 900   @Editable
    render: Render = {mesh = .Duck}
}

Reflection_Volume_Entity :: entity {
    volume: Box_Volume = { half_extents = {256, 256, 256} }
}

Game_Rules_Entity :: entity is Objective {
}

Logic_Counter_Entity :: entity is Counting {
    counter: Counter
}
