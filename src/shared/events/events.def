// events.def -- the gameplay event channel.
//
// Emits the same three files as effects.def, named from THIS stem:
// generated/events_generated.{hpp,cpp} and client_events_bindings_generated.cpp,
// whose switch calls client::game_events::on_<member> -- one hand-written file
// each under src/client/game_events/.
//
// The other half of the event family; effects.def is its twin and carries the
// full note on what a `channel` is. Same construct, same emitted surface -- the
// two files differ only in which packet their batch rides.
//
// Reliable: the batch is its own message. Lost = a visible gap, so it is not
// allowed to be lost. Missing kill feed entries, missing score updates.
//
// ORDER IS THE WIRE ID. Append.

Game_Event :: channel
{
    // Shared prefix, empty today. server_tick: u32 lands here when a consumer
    // wants it -- a channel field costs every event on the wire.
}

Rocket_Detonated :: Game_Event  "a rocket detonated, by impact or lifetime expiry"
{
    attacker_id: u32
    victim_id:   u32   // 0 = splash-only, no direct victim
    weapon_id:   u16
}

Player_Died :: Game_Event  "a player's health crossed from >0 to <=0"
{
    victim_id:    u32
    attacker_id:  u32  // 0 = world/suicide
    weapon_id:    u16
    was_headshot: bool
}

Player_Spawned :: Game_Event  "a player entered the world at a spawn point"
{
    player_id:         u32
    client_slot:       i32
    spawn_position:    v3
    spawn_orientation: quat // the Entity rotation, x y z w
}

Objective_Reached :: Game_Event  "the level's objective was completed"
{
    completed_by: u32   // activator uid, 0 = nobody
    attempt_ticks: u32  // ticks since Live began; 0 = not a timed run
    best_ticks:    u32  // the map's best on file BEFORE this run; 0 = none
}
